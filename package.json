{
  "name": "pillystreamer",
  "version": "1.0.0",
  "description": "Local Minecraft server and autonomous survival streamer",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "server": "node scripts/server.mjs",
    "bot": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.*",
    "typecheck": "tsc",
    "format:check": "prettier --check .",
    "overlay": "tsx src/overlay/start.ts",
    "voice:setup": "tsx scripts/voice-setup.ts",
    "brain:setup": "tsx scripts/brain-setup.ts",
    "viewer:build": "node scripts/build-viewer.mjs",
    "prebot": "npm run viewer:build",
    "pretest": "npm run viewer:build",
    "camera": "node scripts/native-client.mjs",
    "evaluate": "tsx scripts/evaluate.ts",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwiftdev/pillystreamer.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/pwiftdev/pillystreamer/issues"
  },
  "homepage": "https://github.com/pwiftdev/pillystreamer#readme",
  "dependencies": {
    "events": "3.3.0",
    "express": "^4.22.3",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.128.0",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
